{
  "blocksci-external": {
    "directives": [
      "#PBS -N blocksci_external_s3",
      "#PBS -l select=1:ncpus=8:mem=64gb:scratch_ssd=100gb:multijob=brno",
      "#PBS -l walltime=24:00:00",
      "#PBS -j oe"
    ],
    "settings": {
      "artifact_uri": "s3://bucket/runs",
      "command": "PYTHONPATH=/blocksci/.venv/lib/python3.8/site-packages:/mnt/blocksci/blockscipy /usr/bin/python3 /mnt/exporters/worker.py analyze --run-dir /runs/emulation/logs/external-report --coinjoin-type wasabi2 --min-input-count default --joinmarket-detector definite --joinmarket-min-base-fee 5000 --joinmarket-percentage-fee 4e-05 --joinmarket-max-depth 200000 --blocksci-image docker://ghcr.io/ondrejman/blocksci-complete:latest --coinjoin-analysis-image docker://ghcr.io/ondrejman/coinjoin-analysis:latest --coinjoin-emulator-image ghcr.io/ondrejman/emulator-manager:latest --uploader-image ghcr.io/example/uploader:fixed --mode external --network bitcoin --skip-clustering --report --pin-height 850000",
      "credentials": "/storage/home/user/.aws/credentials",
      "endpoint": "https://s3.example",
      "image": "docker://ghcr.io/ondrejman/blocksci-complete:latest",
      "image_name": "docker://ghcr.io/ondrejman/blocksci-complete:latest",
      "inputs": [
        {
          "run": ".pipeline/exporters"
        },
        {
          "to": "coinjoin-analysis_data/coinjoin_tx_info.json",
          "uri": "s3://bucket/dumplings/wasabi2/coinjoin_tx_info.json"
        },
        {
          "optional": true,
          "to": "coinjoin-analysis_data/dumplings-snapshot.json",
          "uri": "s3://bucket/dumplings/wasabi2/dumplings-snapshot.json"
        },
        {
          "to": "coinjoin-analysis_data/false_cjtxs.json",
          "uri": "s3://bucket/dumplings/wasabi2/false_cjtxs.json"
        }
      ],
      "job": "blocksci-analysis",
      "job_log": "blocksci-external.pbs.log",
      "log_prefix": "s3://bucket/runs/external-report/logs",
      "ncpus": 8,
      "output": {
        "relative": "coinjoinPipeline_data"
      },
      "output_check": [
        "coinjoinPipeline_data/unified_report.json",
        "External BlockSci report did not produce unified_report.json"
      ],
      "persistent": {
        "backup_uri": "s3://bucket/mainnet/blocksci-index",
        "dumplings_dir": null,
        "dumplings_uri": null,
        "in_scratch": true,
        "index_dir": "/scratch/multijob-brno/user/blocksci-mainnet",
        "lock_seconds": 87000,
        "poll_seconds": 60,
        "restore": false,
        "storage_report_uri": null,
        "wait_seconds": 43200
      },
      "profile": "test",
      "run_id": "external-report",
      "run_prefix": "s3://bucket/runs/external-report",
      "source_run_id": null,
      "stage": "blocksci-external"
    },
    "shipped_files": [
      "settings.json",
      "run.py",
      "coinjoin_pipeline/__init__.py",
      "coinjoin_pipeline/storage/__init__.py",
      "coinjoin_pipeline/storage/s5client.py",
      "coinjoin_pipeline/execution/__init__.py",
      "coinjoin_pipeline/execution/pbs/__init__.py",
      "coinjoin_pipeline/execution/pbs/index_store.py",
      "coinjoin_pipeline/execution/pbs/stage_settings.py",
      "coinjoin_pipeline/execution/pbs/stage.py",
      "coinjoin_pipeline/execution/pbs/analyzer_jobs.py",
      "coinjoin_pipeline/execution/pbs/blocksci_jobs.py",
      "coinjoin_pipeline/execution/pbs/stage_runtime.py"
    ]
  }
}

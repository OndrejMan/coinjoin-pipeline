{
  "blocksci-notebook": {
    "directives": [
      "#PBS -N blocksci_notebook_s3",
      "#PBS -l select=1:ncpus=8:mem=64gb:scratch_ssd=100gb:multijob=brno",
      "#PBS -l walltime=24:00:00",
      "#PBS -j oe"
    ],
    "settings": {
      "artifact_uri": "s3://bucket/runs",
      "command": "PYTHONPATH=/blocksci/.venv/lib/python3.8/site-packages:/mnt/blocksci/blockscipy /usr/bin/python3 /mnt/blocksci_notebook.py 9000",
      "connection_help": [
        "[blocksci-notebook] Preferred Jupyter port: 9000",
        "[blocksci-notebook] Open JupyterLab from Scenario Lab; connection details follow after startup."
      ],
      "credentials": "/storage/home/user/.aws/credentials",
      "endpoint": "https://s3.example",
      "image": "docker://ghcr.io/ondrejman/blocksci-complete:latest",
      "image_name": "docker://ghcr.io/ondrejman/blocksci-complete:latest",
      "inputs": [],
      "job": "blocksci-analysis",
      "job_log": "blocksci-notebook.pbs.log",
      "log_prefix": "s3://bucket/runs/notebook-in-place/logs",
      "ncpus": 8,
      "output": {
        "notebook": true,
        "notebooks_dir": "/storage/home/user/notebooks",
        "relative": "blocksci-notebooks_data"
      },
      "output_check": null,
      "persistent": {
        "backup_uri": null,
        "dumplings_dir": "/scratch/multijob-brno/user/mainnet/dumplings/Scanner",
        "dumplings_uri": null,
        "in_scratch": false,
        "index_dir": "/scratch/multijob-brno/user/blocksci-mainnet",
        "lock_seconds": 87000,
        "poll_seconds": 60,
        "restore": false,
        "storage_report_uri": null,
        "wait_seconds": 43200
      },
      "profile": "test",
      "run_id": "notebook-in-place",
      "run_prefix": "s3://bucket/runs/notebook-in-place",
      "source_run_id": null,
      "stage": "blocksci-notebook"
    },
    "shipped_files": [
      "settings.json",
      "run.py",
      "coinjoin_pipeline/__init__.py",
      "coinjoin_pipeline/storage/__init__.py",
      "coinjoin_pipeline/storage/s5client.py",
      "coinjoin_pipeline/execution/__init__.py",
      "coinjoin_pipeline/execution/pbs/__init__.py",
      "coinjoin_pipeline/execution/pbs/index_store.py",
      "coinjoin_pipeline/execution/pbs/apptainer.py",
      "exporters/__init__.py",
      "exporters/artifact_paths.py",
      "coinjoin_pipeline/execution/pbs/stage_settings.py",
      "coinjoin_pipeline/execution/pbs/stage.py",
      "coinjoin_pipeline/execution/pbs/analyzer_jobs.py",
      "coinjoin_pipeline/execution/pbs/blocksci_index.py",
      "coinjoin_pipeline/execution/pbs/blocksci_jobs.py",
      "coinjoin_pipeline/execution/pbs/blocksci_analysis_jobs.py",
      "coinjoin_pipeline/execution/pbs/stage_runtime.py",
      "coinjoin_pipeline/execution/pbs/templates/__init__.py",
      "coinjoin_pipeline/execution/pbs/templates/blocksci_notebook.py"
    ]
  }
}

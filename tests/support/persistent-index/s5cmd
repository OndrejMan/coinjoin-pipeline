#!/usr/bin/env bash
# Stand-in for s5cmd backed by a directory: s3://bucket/key is $FAKE_S3/bucket/key.
# Supports cp, sync, run, ls, cat, rm and pipe used by the PBS templates.
set -euo pipefail

local_path() {
    case "$1" in
        s3://*) printf '%s/%s' "${FAKE_S3:?}" "${1#s3://}" ;;
        *) printf '%s' "$1" ;;
    esac
}

copy() {
    local source destination matched=0
    source=$(local_path "$1")
    destination=$(local_path "$2")
    case "$2" in */) mkdir -p "$destination" ;; *) mkdir -p "$(dirname "$destination")" ;; esac
    shopt -s nullglob dotglob
    # Unquoted on purpose: a trailing * in the source is a wildcard, as in s5cmd.
    for item in $source; do
        matched=1
        cp -r "$item" "$destination"
    done
    [ "$matched" = 1 ] || [ "$3" = sync ] || { echo "fake s5cmd: no object matches $1" >&2; exit 1; }
}

json_output=0
while [ $# -gt 0 ]; do
    case "$1" in
        --credentials-file|--profile|--endpoint-url) shift 2 ;;
        --json) json_output=1; shift ;;
        *) break ;;
    esac
done
command=$1
shift
case "$command" in
    version) echo fake ;;
    ls)
        if [[ "$1" == */\* ]]; then
            # A trailing wildcard lists every object below the prefix, as s5cmd does.
            python3 - "$(local_path "${1%\*}")" "${1%\*}" "$json_output" <<'PY'
import json, os, sys
root, prefix, as_json = sys.argv[1], sys.argv[2], sys.argv[3] == '1'
found = []
for directory, _, names in os.walk(root):
    for name in sorted(names):
        path = os.path.join(directory, name)
        found.append((prefix + os.path.relpath(path, root), os.stat(path).st_size))
if not found:
    sys.exit('fake s5cmd: no object found')
for key, size in sorted(found):
    print(json.dumps(dict(key=key, size=size, type='file')) if as_json else key)
PY
            exit 0
        fi
        target=$(local_path "$1")
        [ -e "$target" ] || { echo "fake s5cmd: no object found" >&2; exit 1; }
        if [ "$json_output" = 0 ]; then
            echo "$1"
            exit 0
        fi
        python3 - "$(local_path "$1")" "$1" <<'PY'
import json, os, sys
size = os.stat(sys.argv[1]).st_size + int(os.environ.get('FAKE_S5CMD_LS_SIZE_DELTA', '0'))
print(json.dumps(dict(key=sys.argv[2], size=size)))
PY
        ;;
    cat)
        if [[ "$1" == *.tar.zst && -n "${FAKE_S5CMD_FORBID_ARCHIVE_CAT:-}" ]]; then
            echo 'archive read-back is forbidden by this test' >&2; exit 1
        fi
        cat "$(local_path "$1")"
        ;;
    rm)
        for uri in "$@"; do
            rm -rf "$(local_path "$uri")"
        done
        ;;
    pipe)
        # FAKE_S5CMD_NO_PIPE acts as s5cmd 2.1, FAKE_S5CMD_FAIL_PIPE as an upload that breaks.
        [ -n "${FAKE_S5CMD_NO_PIPE:-}" ] && { echo "unknown command pipe" >&2; exit 1; }
        [ "${1:-}" = --help ] && { echo "pipe <destination>"; exit 0; }
        [ -n "${FAKE_S5CMD_FAIL_PIPE:-}" ] && { cat >/dev/null; echo "upload failed" >&2; exit 1; }
        destination=$(local_path "$1")
        mkdir -p "$(dirname "$destination")"
        cat >"$destination"
        ;;
    cp) copy "$1" "$2" cp ;;
    sync)
        delete=0
        [ "$1" = --delete ] && { delete=1; shift; }
        source=$1
        if [ "$delete" = 1 ] && [ -d "$(local_path "${source%/}")" ]; then
            # Mirror a directory: objects without a source file go, as with s5cmd sync --delete.
            destination=$(local_path "$2")
            rm -rf "$destination"
        fi
        case "$source" in */) source="${source}*" ;; esac
        copy "$source" "$2" sync
        ;;
    run)
        while read -r line; do
            [ -n "$line" ] && eval "$0 $line"
        done <"$1"
        ;;
    *) echo "fake s5cmd: unsupported command $command" >&2; exit 2 ;;
esac
